<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>mdk: third-party licences</title>
<style>
  body { font: 14px/1.5 system-ui, sans-serif; max-width: 860px; margin: 2rem auto; padding: 0 1rem; }
  pre { white-space: pre-wrap; background: #f4f4f5; padding: 1rem; font-size: 12px; }
  h2 { margin-top: 2.5rem; }
  li { margin: 0.15rem 0; }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>mdk is MIT licensed. It is built from the open-source crates below, plus the Geist font (SIL OFL 1.1) and Tabler icons (MIT). Each licence appears once, with the crates that use it.</p>

<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>

{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<ul>
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
